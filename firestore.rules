rules_version = '2';

// =====================================================
// Firestore security rules for WorkoutTracker, FoodTracker & RPG Fitness
// =====================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // WORKOUT TRACKER RULES (Do not touch)
    // =====================================================

    // === Curated content (read-only) ===
    match /legendary_routines/{routineId} {
      allow read: if true;
      allow write: if false;
    }
    match /explore_programs/{programId} {
      allow read: if true;
      allow write: if false;
    }

    // === User-generated shared workouts ===
    match /shared_workouts/{workoutId} {
      // Read: only approved workouts, OR your own doc (any status)
      allow read: if (resource.data.status == "approved")
                  || (request.auth != null
                      && resource.data.creatorUid == request.auth.uid);

      // Create: must be authed; creatorUid must equal own UID;
      // must start as pending with zero reports; size limits on text.
      allow create: if request.auth != null
                    && request.resource.data.creatorUid == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.reportCount == 0
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && (!("description" in request.resource.data)
                        || (request.resource.data.description is string
                            && request.resource.data.description.size() <= 2000));

      // Update: server-only (no client updates — moderation function uses admin)
      allow update: if false;

      // Delete: only owner can delete their own document
      allow delete: if request.auth != null
                    && resource.data.creatorUid == request.auth.uid;
    }

    // === Reports (WorkoutTracker + FitRPG) ===
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid
                    && (
                      // WorkoutTracker shared-workout reports
                      (request.resource.data.workoutId is string
                       && request.resource.data.reason in
["spam", "hate", "harassment", "sexual", "violence", "dangerous", "other"]
                       && (!("details" in request.resource.data)
                           || (request.resource.data.details is string
                               && request.resource.data.details.size() <= 500)))
                      ||
                      // FitRPG player reports
                      (request.resource.data.app == "fitrpg"
                       && request.resource.data.targetUid is string
                       && request.resource.data.reason is string
                       && request.resource.data.reason.size() > 0
                       && request.resource.data.reason.size() <= 200
                       && request.resource.data.keys().hasAll(['reporterUid', 'targetUid', 'reason', 'createdAt', 'app']))
                    );
      allow read, update, delete: if false;
    }

    // === Per-user blocked list ===
    match /users/{userId}/blocked/{blockedUid} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // =====================================================
    // FOOD TRACKER RULES
    // =====================================================

    // === Curated content (read-only for clients, managed by admin) ===
    match /premium_recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }
    match /academy_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    match /diets/{dietId} {
      allow read: if true;
      allow write: if false;
    }
    match /fasting_plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // === Custom Barcodes (Shared Crowdsourced DB) ===
    match /custom_barcodes/{barcode} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // === Global Community Foods (AI & Manual) ===
    match /global_community_foods/{foodId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // =====================================================
    // RPG FITNESS RULES
    // Economy / rewards / trophies / owned gear: Cloud Functions only.
    // Sibling apps may still merge non-FitRPG fields on users/{uid}.
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // FitRPG economy + social graph fields — never client-authoritative on update.
    // Gold may only decrease client-side (deposits); increases are CF-only.
    // Energy may only decrease client-side; increases via adjustEnergy CF.
    // Base stats / equipped slots are CF-only (equipItem). clanId: leave or
    // join only when auth.uid is already in that clan's memberIds.
    function fitrpgProtectedKeys() {
      return [
        'progressions', 'ownedEquipmentIds', 'classTrophies',
        'pvpWins', 'pvpTrophies', 'statPoints', 'basePower', 'maxEnergy',
        'friends', 'friendRequests',
        'baseStrength', 'baseDexterity', 'baseIntelligence', 'baseVitality',
        'equippedWeaponId', 'equippedArmorId', 'equippedRingId', 'equippedAmuletId',
        'lastEnergyRegenAt', 'pendingEnergyCharges'
      ].toSet();
    }

    // Energy never increases via client (path-1 sibling apps + FitRPG sync).
    function fitrpgEnergyNotIncreased() {
      return !('energy' in resource.data)
        || !('energy' in request.resource.data)
        || (
          request.resource.data.energy is int
          && request.resource.data.energy >= 0
          && request.resource.data.energy <= resource.data.energy
        );
    }

    // clanId: unchanged, cleared (leave), or set to a clan that already lists this uid.
    function fitrpgClanIdOk() {
      return !('clanId' in request.resource.data.diff(resource.data).affectedKeys())
        || !('clanId' in request.resource.data)
        || request.resource.data.clanId == null
        || (
          request.resource.data.clanId is string
          && exists(/databases/$(database)/documents/clans/$(request.resource.data.clanId))
          && get(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.memberIds is list
          && request.auth.uid in get(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.memberIds
        );
    }

    function fitrpgEconomyUnchanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(fitrpgProtectedKeys()) == false
        && request.resource.data.energy is int
        && request.resource.data.energy >= 0
        && request.resource.data.energy <= resource.data.energy
        && request.resource.data.gold is int
        && request.resource.data.gold >= 0
        && request.resource.data.gold <= resource.data.gold
        && fitrpgClanIdOk();
    }

    function fitrpgCreateEconomyOk() {
      return request.resource.data.gold is int
        && request.resource.data.gold >= 0
        && request.resource.data.gold <= 100
        && request.resource.data.energy is int
        && request.resource.data.energy >= 0
        && request.resource.data.energy <= 100
        && request.resource.data.maxEnergy is int
        && request.resource.data.maxEnergy == 100;
    }

    // Users Collection (and all its subcollections like notifications)
    match /users/{userId} {
      allow read: if isSignedIn();

      // Create character (or sibling-app first write). FitRPG starter caps apply when gold present.
      allow create: if isUser(userId)
                    && (
                      !('gold' in request.resource.data)
                      || fitrpgCreateEconomyOk()
                    );

      // Owner may update profile / stats — not economy increases (energy/gold CF-only up).
      allow update: if isUser(userId) && (
        // Non-FitRPG / partial merges (FoodTracker etc.): no protected keys touched
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(fitrpgProtectedKeys())
          && fitrpgEnergyNotIncreased()
          && fitrpgClanIdOk()
          && (
            !('gold' in resource.data)
            || !('gold' in request.resource.data)
            || request.resource.data.gold <= resource.data.gold
          )
        )
        // FitRPG character sync: energy bounded, gold not increased, protected keys unchanged
        || (
          ('energy' in resource.data)
          && fitrpgEconomyUnchanged()
        )
      );

      // Account wipe of shared user doc is CF-only (cross-app safety).
      allow delete: if false;

      // Notifications subcollection: any authenticated user can CREATE a notification
      // for any other user (needed for friend requests, duel invites, team invites)
      match /notifications/{notifId} {
        allow read, delete: if isUser(userId);
        allow create, update: if isSignedIn();
      }

      // All other subcollections: owner only (Stepper workouts, blocked, etc.)
      match /{subcollection}/{document=**} {
        allow read, write: if isUser(userId);
      }
    }

    // Clans — create own clan; trophies/activeWar CF-only; members only by leader or self-join via memberIds
    match /clans/{clanId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.leaderId == request.auth.uid
                    && !('activeWar' in request.resource.data)
                    && request.resource.data.trophies is int
                    && request.resource.data.trophies == 1000
                    && request.resource.data.memberIds is list
                    && request.auth.uid in request.resource.data.memberIds;

      allow update: if isSignedIn()
                    && (
                      !('activeWar' in resource.data)
                      || request.resource.data.activeWar == resource.data.activeWar
                    )
                    && request.resource.data.trophies == resource.data.trophies
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['totalReps', 'members', 'description', 'emblem', 'name', 'memberIds', 'treasuryGold'])
                    && (
                      resource.data.leaderId == request.auth.uid
                      || (
                        resource.data.memberIds is list
                        && request.auth.uid in resource.data.memberIds
                      )
                      || (
                        // Self-join: add own uid to memberIds exactly once
                        request.resource.data.memberIds is list
                        && request.auth.uid in request.resource.data.memberIds
                        && (
                          !(resource.data.memberIds is list)
                          || !(request.auth.uid in resource.data.memberIds)
                        )
                        && (
                          !(resource.data.memberIds is list)
                          || request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                        )
                      )
                    );

      allow delete: if isSignedIn()
                    && resource.data.leaderId == request.auth.uid;
    }

    // World Bosses — client read-only; Cloud Functions (Admin SDK) write
    match /world_bosses/{bossId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Battles — only participants; combat HP/reps OK; winnerId/rewardsSettled/participantUids CF-or-immutable
    match /battles/{battleId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.participantUids is list
                    && request.auth.uid in request.resource.data.participantUids
                    && !('rewardsSettled' in request.resource.data)
                    && !('winnerId' in request.resource.data)
                    && !('surrenderedBy' in request.resource.data)
                    && !('createdByServer' in request.resource.data);

      allow update: if isSignedIn()
                    && resource.data.participantUids is list
                    && request.auth.uid in resource.data.participantUids
                    && request.resource.data.participantUids == resource.data.participantUids
                    && (
                      !('rewardsSettled' in resource.data)
                      || request.resource.data.rewardsSettled == resource.data.rewardsSettled
                    )
                    && (
                      !('rewardsSettled' in request.resource.data)
                      || (
                        'rewardsSettled' in resource.data
                        && request.resource.data.rewardsSettled == resource.data.rewardsSettled
                      )
                    )
                    // Client cannot forge winnerId (CF derives on settle)
                    && (
                      !('winnerId' in resource.data)
                      || request.resource.data.winnerId == resource.data.winnerId
                    )
                    && (
                      !('winnerId' in request.resource.data)
                      || ('winnerId' in resource.data
                          && request.resource.data.winnerId == resource.data.winnerId)
                    )
                    // createdByServer is CF-only (immutable once set; client cannot add)
                    && (
                      !('createdByServer' in request.resource.data.diff(resource.data).affectedKeys())
                    )
                    // Surrender: only set surrenderedBy to self
                    && (
                      !('surrenderedBy' in request.resource.data.diff(resource.data).affectedKeys())
                      || request.resource.data.surrenderedBy == request.auth.uid
                    );

      allow delete: if false;
    }

    // Matchmaking — own ticket create/update/delete; others read for invites
    match /matchmaking/{ticketId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
                    && (
                      resource.data.uid == request.auth.uid
                      || resource.data.targetUid == request.auth.uid
                      || (resource.data.pendingInvites is list
                          && request.auth.uid in resource.data.pendingInvites)
                    );

      allow delete: if isSignedIn()
                    && (resource.data.uid == request.auth.uid
                        || resource.data.targetUid == request.auth.uid);
    }

    // FitRPG UGC reports are merged into the shared /reports rule above (Workout + FitRPG).

    // =====================================================
    // YOGA (client collections; CF yogaDeleteUserData uses Admin SDK)
    // =====================================================
    match /yoga_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /yoga_leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == entryId;
    }

    // === Default deny for everything else ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
